{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runner-analysis.local/contracts/analysis/v1/analysis-event.schema.json",
  "title": "AnalysisEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "request_id", "run_id", "compute_location", "sequence", "timestamp", "stage", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "compute_location": {"enum": ["server", "local"]},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "stage": {"enum": ["validating", "prescan", "tracking", "pose2d", "pose3d", "speed", "gait", "export", "sync", "completed", "failed"]},
    "status": {"enum": ["started", "progress", "completed", "skipped", "failed"]},
    "message": {"type": "string"},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "total", "unit"],
      "properties": {
        "completed": {"type": "number", "minimum": 0},
        "total": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"enum": ["fraction", "frames", "cameras", "artifacts"]}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retriable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retriable": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {"required": ["error"]}
    }
  ]
}
